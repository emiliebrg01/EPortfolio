# Fichier d'exemple des variables d'environnement.
# Copier ce fichier en ".env" et remplir les valeurs réelles.
# Ne jamais committer le fichier ".env" sur GitHub.

# Clé secrète utilisée pour signer et vérifier les cookies de session.
# Permet à l'application de détecter toute tentative de falsification de session.
# Doit être une chaîne aléatoire longue et unique par environnement.
# Générer une clé avec : python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=your-secret-key-here
ADMIN_SECRET=une-autre-cle-aleatoire
